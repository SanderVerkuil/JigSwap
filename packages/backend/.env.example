# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://distinct-goshawk-54.clerk.accounts.dev

# Convex Backend
CONVEX_DEPLOYMENT=your_convex_deployment_url_here
NEXT_PUBLIC_CONVEX_URL=https://your_convex_deployment.convex.cloud

# Crowdin Localization
CROWDIN_PROJECT_ID=your_crowdin_project_id
CROWDIN_API_TOKEN=your_crowdin_api_token
NEXT_PUBLIC_CROWDIN_DISTRIBUTION_HASH=your_crowdin_distribution_hash

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: Analytics and Monitoring
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here
SENTRY_DSN=your_sentry_dsn_here

# Optional: File Upload (if implementing image uploads)
NEXT_PUBLIC_UPLOAD_ENDPOINT=your_upload_endpoint_here
UPLOAD_SECRET=your_upload_secret_here

# Optional: AhaSend (ahasend.com) — transactional email delivery (EU provider).
# Set these on the Convex deployment (npx convex env set). Only AHASEND_API_KEY and
# AHASEND_ACCOUNT_ID are required to enable delivery; when either is unset, email notifications
# are dropped with a log and the in-app feed keeps working regardless. Only EMAIL_ELIGIBLE_TYPES
# (domain notification-type.ts) are ever emailed, gated further by per-member preferences.
#   AHASEND_API_KEY:    aha-sk-… API key with send permission for the jigswap.site domain.
#   AHASEND_ACCOUNT_ID: the AhaSend account UUID (part of the v2 API URL).
#   EMAIL_FROM:         default no-reply@jigswap.site; override only if the address ever changes.
#   EMAIL_FROM_NAME:    display name, default "JigSwap".
#   EMAIL_BASE_URL:     web-app origin for CTA/preferences links, e.g. https://jigswap.site
#                       (must be a bare origin, no path); preview deployments get this set
#                       automatically by scripts/vercel-build.sh.
#   AHASEND_SANDBOX:    DEFAULTS TO TRUE (accept-but-don't-deliver). Production explicitly sets
#                       AHASEND_SANDBOX=false to deliver real email.
AHASEND_API_KEY=aha-sk-your-ahasend-api-key
AHASEND_ACCOUNT_ID=your-ahasend-account-uuid
EMAIL_FROM=no-reply@jigswap.site
EMAIL_FROM_NAME=JigSwap
EMAIL_BASE_URL=https://jigswap.site
AHASEND_SANDBOX=true

# Image moderation for uploaded copy and completion photos (library/moderatePhoto.ts,
# solving/moderateCompletionPhoto.ts). Set these on the Convex deployment (npx convex env set).
# The pipeline always re-encodes uploads (stripping EXIF); classification goes to the Hugging Face
# Inference Providers router (https://router.huggingface.co/hf-inference/models/<model>).
#   MODERATION_PROVIDER:       "huggingface" (default) | "sightengine" | "none" (explicitly off:
#                              approve unchecked).
#   HF_MODERATION_TOKEN:       Hugging Face access token with the "Inference Providers" permission.
#                              When UNSET (or invalid) photos are NOT approved: they end "unscored",
#                              visible to their uploader only, and the admin console warns.
#   HF_MODERATION_MODEL:       optional, default Falconsai/nsfw_image_detection.
#   SIGHTENGINE_API_USER:      Sightengine API user (MODERATION_PROVIDER=sightengine).
#   SIGHTENGINE_SECRET_KEY:    Sightengine API secret. Either missing => photos end "unscored".
#   SIGHTENGINE_MODEL:         optional, default nudity-2.1 (decisive score = highest of
#                              sexual_activity / sexual_display / erotica).
#   MODERATION_NSFW_THRESHOLD: float in [0,1], default 0.85. An nsfw score >= threshold => rejected.
# Provider errors retry with backoff (1, 5, 30 min) before a photo ends "unscored".
MODERATION_PROVIDER=huggingface
HF_MODERATION_TOKEN=hf_your_huggingface_inference_token
MODERATION_NSFW_THRESHOLD=0.85

# CSAM hash matching (lib/imageModeration/csamHashCheck.ts), run in the shared moderation pipeline
# BEFORE classification for every image table. Set on the Convex deployment (npx convex env set).
# INERT unless fully configured: unset (or any Offlimits var missing) behaves as "none".
# Only MD5 + SHA-1 hashes are sent, never image bytes; credentials and hashes are never logged.
# On a match the photo is quarantined (never shown to anyone, admins included; the blob is kept),
# and an escalation appears under Admin > Moderation > Hash matches for the operator to report to
# Meldpunt Offlimits (https://meldpunt.offlimits.nl) or the police.
#   CSAM_HASHCHECK_PROVIDER: "none" (default) | "offlimits" (Offlimits / EOKM HashCheckService).
#   OFFLIMITS_HCS_BASE_URL:  the HashCheckService endpoint from Offlimits (https only).
#   OFFLIMITS_HCS_USERNAME:  HCS user id.
#   OFFLIMITS_HCS_PASSWORD:  HCS password.
# HCS allow-lists caller IPs. Convex has no fixed egress IP, and a proxy
# (OFFLIMITS_HCS_PROXY_URL) is NOT supported yet: Node's fetch only takes a proxy via undici's
# ProxyAgent, which would need undici as a new dependency. Until then HCS calls from Convex will
# be refused by the allow-list and logged as "unavailable" (uploads continue to classification).
# The request/response mapping is PROVISIONAL (offlimitsHcsWireFormat): align it with the HCS API
# manual once access is granted.
CSAM_HASHCHECK_PROVIDER=none
OFFLIMITS_HCS_BASE_URL=
OFFLIMITS_HCS_USERNAME=
OFFLIMITS_HCS_PASSWORD=
