exports[`renderInviteEmail > pins the rendered layout 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="background-color:#f5f5f4"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Anna invited you to JigSwap to follow each other. JigSwap is where puzzlers share, swap and lend their jigsaw puzzles. Once you have joined, you choos</div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:Helvetica, Arial, sans-serif"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:480px;background-color:#ffffff;border-radius:8px;margin:24px auto;padding:32px"><tbody><tr style="width:100%"><td><p style="font-size:20px;line-height:24px;font-weight:700;margin:0 0 24px;margin-top:0;margin-right:0;margin-bottom:24px;margin-left:0">🧩 JigSwap</p><h1 style="font-size:18px;font-weight:600;margin:0 0 12px">Anna invited you to JigSwap</h1><p style="font-size:14px;line-height:22px;color:#333333;margin:0 0 24px;margin-top:0;margin-right:0;margin-bottom:24px;margin-left:0">Anna invited you to JigSwap to follow each other. JigSwap is where puzzlers share, swap and lend their jigsaw puzzles. Once you have joined, you choose whether you follow each other.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td><a href="https://accounts.jigswap.site/v1/tickets/accept?ticket=tkt_1" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1d4ed8;border-radius:6px;color:#ffffff;font-size:14px;font-weight:600;padding:10px 20px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px" target="_blank"><span><!--[if mso]><i style="mso-font-width:500%;mso-text-raise:15" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:7.5px">Join JigSwap</span><span><!--[if mso]><i style="mso-font-width:500%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:32px 0 16px"/><p style="font-size:12px;line-height:18px;color:#78716c;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Anna invited you with this email address. If you ignore this email, nothing more happens: JigSwap keeps no copy of your address, and the invitation expires after 14 days.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`renderInviteEmail > pins the rendered layout 2`] = `
"🧩 JigSwap


ANNA INVITED YOU TO JIGSWAP

Anna invited you to JigSwap to follow each other. JigSwap is where puzzlers share, swap and lend their jigsaw puzzles. Once you have joined, you choose whether you follow each other.

Join JigSwap https://accounts.jigswap.site/v1/tickets/accept?ticket=tkt_1

----------------------------------------

Anna invited you with this email address. If you ignore this email, nothing more happens: JigSwap keeps no copy of your address, and the invitation expires after 14 days."
`;
