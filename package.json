{
  "name": "jigswap-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@jigswap/web",
    "dev:web": "turbo run dev --filter=@jigswap/web",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@jigswap/web",
    "start": "turbo run start --filter=@jigswap/web",
    "start:web": "turbo run start --filter=@jigswap/web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "rm -rf .turbo apps/*/dist apps/*/.output packages/*/dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "turbo run build lint type-check test --graph=graph.html",
    "affected": "turbo run lint type-check test build --affected",
    "arch:check": "depcruise --config .dependency-cruiser.cjs packages/domain/src",
    "mutation:domain": "turbo run mutation --filter=@jigswap/domain"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "jiti": "2.7.0",
    "next": "16.2.7",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tslib": "^2.8.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
